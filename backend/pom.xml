<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml = the "shopping list" for the backend.
  Maven reads this file, downloads every library listed under <dependencies>,
  and knows how to compile, test and package the app.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Inherit sensible defaults (library versions, plugin settings) from Spring Boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.lastdrop</groupId>
    <artifactId>lastdrop-backend</artifactId>
    <version>0.1.0</version>
    <name>lastdrop-backend</name>
    <description>LASTDROP - reverse-auction hyperlocal dead-stock clearinghouse (backend)</description>

    <properties>
        <!-- Compile for Java 17 (the LTS the project targets). Newer JDKs such as 21 or 24 can build it too. -->
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- REST APIs: lets us write controllers that answer HTTP requests with JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Input validation annotations such as @NotBlank, @Email, @Positive -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Automated tests (JUnit 5, MockMvc, AssertJ) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          More dependencies are added in later phases, when we actually use them:
            Phase 3:  spring-boot-starter-data-jpa, mysql-connector-j
            Phase 4:  spring-boot-starter-security, jjwt
            Phase 9:  spring-boot-starter-websocket
          Adding them now would make the app refuse to start without a database.
        -->
    </dependencies>

    <build>
        <plugins>
            <!-- Lets us run the app with "mvnw spring-boot:run" and build a runnable .jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
