# Copy to ".env" (same folder as docker-compose.yml) and change the values.
# .env is ignored by Git - never commit real passwords.

MYSQL_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-app
JWT_SECRET=change-me-to-a-long-random-text-of-40-or-more-characters
# Port the app opens on: http://localhost:3000
APP_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DEMO_MODE=false
# Optional: Google OAuth Client ID to show the "Sign in with Google" button
GOOGLE_CLIENT_ID=
